# ONCE deployment template; copy to services/core/.env.once, never commit actual values.
# This instance never connects to the LinePool logical database.
NODE_ENV=production
SITE_ID=once
PRODUCT=NUMBER_LEASE
ENABLED_MODULES=NUMBER_LEASE
PROCESS_ROLE=api
API_HOST=127.0.0.1
API_PORT=3011
TRUSTED_PROXY_IPS=127.0.0.1,::1
WEB_ORIGIN=https://once.example.com
SELF_SERVICE_ORIGINS=https://once.example.com
PASSWORD_RESET_URL=https://once.example.com/reset-password
# Separate role/database; app.site_id=once must already be configured.
DATABASE_URL=postgresql://once_core:change-me@127.0.0.1:5432/once_core
SESSION_TTL_HOURS=24
# Default remains Mock until a concrete real target is prepared and authorized.
PC_MODE=mock
# Real mode requires HTTPS here; use the independent ONCE application and server-only secret.
# PC_BASE_URL=https://your-pinclode-host/pingcode
# PC_CLIENT_SECRET=
# PC_NUMBER_REGION=us
# PC_NUMBER_CAPABILITIES=SEND_SMS
# PC_ISSUER=https://your-pinclode-host/pingcode
PC_APPLICATION_ID=once-application
PC_ISSUER=mock-pinclode
PC_AUTH_CALLBACK_URL=https://once.example.com/api/pc/auth/callback
PC_REFRESH_EARLY_SECONDS=300
PC_POLL_IDLE_SECONDS=60
PC_POLL_WAIT_SECONDS=5
PC_WAIT_SECONDS=120
PC_MOCK_REFRESH_MODE=SUCCESS
PINGCODE_EXTERNAL_ACCOUNT_ID=mock-linepool
# For real self-service replace this site's Mock routing ID with its trusted PC subject.
# ONCE_PINGCODE_EXTERNAL_ACCOUNT_ID=<ONCE self-service PC subject>
ONCE_PINGCODE_EXTERNAL_ACCOUNT_ID=mock-once
PINGCODE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
RECHARGE_RULES=
