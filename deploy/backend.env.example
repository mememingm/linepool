# Copy to linepool-ui/backend/.env on the server and replace placeholders.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3010
WEB_ORIGIN=https://linepool.example.com
DATABASE_URL=postgresql://linepool:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/linepool
SESSION_TTL_HOURS=24
# Password recovery email. Configure an authorized SMTP service to enable sending.
# 587 + false requires STARTTLS in production; 465 + true uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
