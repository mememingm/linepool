# LinePool deployment template; copy to services/core/.env, never commit actual values.
# This file does not authorize database setup, provider access or deployment.
NODE_ENV=production
SITE_ID=linepool
PRODUCT=SMS_CODE
ENABLED_MODULES=SMS_CODE
PROCESS_ROLE=api
API_HOST=127.0.0.1
API_PORT=3010
TRUSTED_PROXY_IPS=127.0.0.1,::1
WEB_ORIGIN=https://linepool.example.com
SELF_SERVICE_ORIGINS=https://linepool.example.com
PASSWORD_RESET_URL=https://linepool.example.com/reset-password
# Separate role/database; app.site_id=linepool must already be configured.
DATABASE_URL=postgresql://linepool:change-me@127.0.0.1:5432/linepool
SESSION_TTL_HOURS=24
# Default remains Mock until a concrete real target is prepared and authorized.
PC_MODE=mock
# Real mode requires HTTPS here and a separately registered application, not GooseMsg.
# PC_BASE_URL=https://your-pinclode-host/pingcode
# PC_CLIENT_SECRET=
# PC_NUMBER_REGION=us
# PC_NUMBER_CAPABILITIES=
# PC_ISSUER=https://your-pinclode-host/pingcode
PC_APPLICATION_ID=linepool-application
PC_ISSUER=mock-pinclode
PC_AUTH_CALLBACK_URL=https://linepool.example.com/api/pc/auth/callback
PC_REFRESH_EARLY_SECONDS=300
PC_POLL_IDLE_SECONDS=60
PC_POLL_WAIT_SECONDS=5
PC_WAIT_SECONDS=120
PC_MOCK_REFRESH_MODE=SUCCESS
# For real self-service replace this site's Mock routing ID with its trusted PC subject.
# PINGCODE_EXTERNAL_ACCOUNT_ID=<LinePool self-service PC subject>
PINGCODE_EXTERNAL_ACCOUNT_ID=mock-linepool
ONCE_PINGCODE_EXTERNAL_ACCOUNT_ID=mock-once
PINGCODE_WEBHOOK_SECRET=
# Authorized SMTP configuration required for recovery; blank means unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
RECHARGE_RULES=
