# Independent ONCE API/worker configuration. Copy to services/core/.env.once.
# No LinePool users, balances or connection strings belong in this database.
NODE_ENV=development
SITE_ID=once
PRODUCT=NUMBER_LEASE
ENABLED_MODULES=NUMBER_LEASE
PROCESS_ROLE=api
# Enable only after explicitly preparing an isolated local _sandbox/_test database.
LOCAL_SANDBOX=false
API_HOST=127.0.0.1
API_PORT=3011
TRUSTED_PROXY_IPS=
WEB_ORIGIN=http://127.0.0.1:5174
SELF_SERVICE_ORIGINS=http://127.0.0.1:5174
PASSWORD_RESET_URL=http://127.0.0.1:5174/reset-password
# Nonsecret placeholder. API and worker require a preconfigured app.site_id=once marker.
DATABASE_URL=postgresql://once_core:change-me@127.0.0.1:5433/once_core_sandbox
SESSION_TTL_HOURS=24
# Cookie is once_core_session, never the legacy once_session or LP session.
# Mock remains the default; real mode requires a separately registered ONCE application.
PC_MODE=mock
# Real-mode settings: replace application/issuer below; SEND_SMS is an explicit opt-in.
# PC_BASE_URL=http://120.55.75.51/pingcode
# PC_CLIENT_SECRET=
# PC_NUMBER_REGION=us
# PC_NUMBER_CAPABILITIES=SEND_SMS
# PC_APPLICATION_ID=once-local
# PC_ISSUER=http://120.55.75.51/pingcode
PC_APPLICATION_ID=mock-once
PC_ISSUER=mock-pinclode
PC_AUTH_CALLBACK_URL=http://127.0.0.1:5174/api/pc/auth/callback
PC_REFRESH_EARLY_SECONDS=300
PC_POLL_IDLE_SECONDS=60
PC_POLL_WAIT_SECONDS=5
PC_WAIT_SECONDS=120
PC_MOCK_REFRESH_MODE=SUCCESS
# Local Mock resource pages; an empty account disables later-page failure injection.
PC_MOCK_SNAPSHOT_PAGE_SIZE=100
PC_MOCK_SNAPSHOT_FAIL_ACCOUNT=
PC_MOCK_SNAPSHOT_FAIL_PAGE=2
PINGCODE_EXTERNAL_ACCOUNT_ID=mock-linepool
# In real mode, this site's self-service external account ID must equal its trusted PC subject.
# ONCE_PINGCODE_EXTERNAL_ACCOUNT_ID=<ONCE self-service PC subject>
ONCE_PINGCODE_EXTERNAL_ACCOUNT_ID=mock-once
PINGCODE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
RECHARGE_RULES=
DEMO_EMAIL=demo@once.local
