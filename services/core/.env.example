# LinePool local API/worker configuration. Copy to services/core/.env.
# The runtime scripts select PROCESS_ROLE; both processes use this site's database only.
NODE_ENV=development
SITE_ID=linepool
PRODUCT=SMS_CODE
ENABLED_MODULES=SMS_CODE
PROCESS_ROLE=api
LOCAL_SANDBOX=false
API_HOST=127.0.0.1
API_PORT=3010
# Exact proxy addresses only. Leave empty for direct local access.
TRUSTED_PROXY_IPS=
WEB_ORIGIN=http://127.0.0.1:5178
SELF_SERVICE_ORIGINS=http://127.0.0.1:5178
PASSWORD_RESET_URL=http://127.0.0.1:5178/reset-password
# Nonsecret placeholder. API and worker require a preconfigured app.site_id=linepool marker.
DATABASE_URL=postgresql://linepool_react:change-me@127.0.0.1:5433/linepool_react
POSTGRES_BIN=D:/postgresql/bin
SESSION_TTL_HOURS=24
# Cookie is linepool_react_session; ONCE uses a different name on the same host.
# Mock remains the default; real mode uses this site's independently registered application.
PC_MODE=mock
# Real-mode settings: replace application/issuer below; keep the secret server-side only.
# PC_BASE_URL=http://120.55.75.51/pingcode
# PC_CLIENT_SECRET=
# PC_NUMBER_REGION=us
# PC_NUMBER_CAPABILITIES=
# PC_APPLICATION_ID=linepool
# PC_ISSUER=http://120.55.75.51/pingcode
PC_APPLICATION_ID=mock-linepool
PC_ISSUER=mock-pinclode
PC_AUTH_CALLBACK_URL=http://127.0.0.1:5178/api/pc/auth/callback
PC_REFRESH_EARLY_SECONDS=300
PC_POLL_IDLE_SECONDS=60
PC_POLL_WAIT_SECONDS=5
PC_WAIT_SECONDS=120
PC_MOCK_REFRESH_MODE=SUCCESS
# Local Mock resource pages; an empty account disables later-page failure injection.
PC_MOCK_SNAPSHOT_PAGE_SIZE=100
PC_MOCK_SNAPSHOT_FAIL_ACCOUNT=
PC_MOCK_SNAPSHOT_FAIL_PAGE=2
# In real mode, this site's self-service external account ID must equal its trusted PC subject.
# PINGCODE_EXTERNAL_ACCOUNT_ID=<LinePool self-service PC subject>
PINGCODE_EXTERNAL_ACCOUNT_ID=mock-linepool
ONCE_PINGCODE_EXTERNAL_ACCOUNT_ID=mock-once
# Optional legacy Mock callback secret; empty keeps the receiver disabled.
PINGCODE_WEBHOOK_SECRET=
# Password recovery is unavailable until an authorized SMTP service is configured.
# Reset tokens are fragments at PASSWORD_RESET_URL, never API response fields.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional recharge previews; administrator settings take precedence. No payment provider.
RECHARGE_RULES=
DEMO_EMAIL=demo@linepool.local
