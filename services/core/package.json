{
  "name": "@linepool/react-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node scripts/run-runtime.mjs api",
    "start:worker": "node scripts/run-runtime.mjs worker",
    "start:once": "node scripts/run-runtime.mjs api once",
    "start:once:worker": "node scripts/run-runtime.mjs worker once",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node scripts/run-runtime.mjs api\"",
    "dev:worker": "tsc-watch -p tsconfig.json --onSuccess \"node scripts/run-runtime.mjs worker\"",
    "dev:once": "tsc-watch -p tsconfig.json --onSuccess \"node scripts/run-runtime.mjs api once\"",
    "dev:once:worker": "tsc-watch -p tsconfig.json --onSuccess \"node scripts/run-runtime.mjs worker once\"",
    "db:local:setup": "node --env-file=.env dist/core/scripts/local-postgres.js setup",
    "db:start": "node --env-file=.env dist/core/scripts/local-postgres.js start",
    "db:stop": "node --env-file=.env dist/core/scripts/local-postgres.js stop",
    "db:status": "node --env-file=.env dist/core/scripts/local-postgres.js status",
    "db:create": "node --env-file=.env dist/core/scripts/create-database.js",
    "db:migrate": "node --env-file=.env dist/core/scripts/migrate.js",
    "db:seed": "node --env-file=.env dist/core/scripts/seed.js",
    "db:allocation-audit": "node --env-file=.env dist/core/scripts/allocation-audit.js",
    "mock:fulfillment": "node --env-file=.env dist/core/scripts/mock-fulfillment.js",
    "once:operator": "node --env-file=.env.once dist/core/scripts/once-operator.js",
    "admin:grant": "node dist/core/scripts/admin-grant.js"
  },
  "dependencies": {
    "@linepool/contracts": "0.1.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~5.9.3"
  }
}
