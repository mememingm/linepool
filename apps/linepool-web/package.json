{
  "name": "@linepool/ui-react",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/linepool-ui.js"
    },
    "./styles.css": "./dist/linepool-ui.css"
  },
  "files": [
    "dist",
    "upstream-lock.json",
    "src/vendor/*/LICENSE",
    "README.md"
  ],
  "scripts": {
    "predev": "npm run build",
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:catalog-upstream": "node scripts/verify-catalog-upstream.mjs",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit",
    "build": "npm run verify:upstream && vite build && tsc -p tsconfig.build.json && node scripts/finalize-package.mjs",
    "build:web": "npm run build && vite build --mode web",
    "preview": "vite preview --mode web --outDir web-dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@linepool/contracts": "0.1.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "glimm": "^0.3.0",
    "gsap": "^3.15.0",
    "iconoir-react": "^7.11.1",
    "liveline": "^0.0.7",
    "lucide-react": "^0.511.0",
    "motion": "^13.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-use-measure": "^2.1.7",
    "shadow-plugin": "^2.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
