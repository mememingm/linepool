NODE_ENV=development
API_HOST=127.0.0.1
# Empty for direct access. Behind a local reverse proxy, explicitly set 127.0.0.1,::1.
# Proxy must overwrite X-Forwarded-For; do not expose the API directly to the internet.
TRUSTED_PROXY_IPS=
API_PORT=3010
WEB_ORIGIN=http://127.0.0.1:5178
# db:local:setup generates the real local connection string automatically.
DATABASE_URL=postgresql://linepool_react:REPLACE_ME@127.0.0.1:5433/linepool_react
POSTGRES_BIN=D:/postgresql/bin
SESSION_TTL_HOURS=24
# Password recovery email; SMTP_HOST and SMTP_FROM are required to enable sending.
# Link base is WEB_ORIGIN. No reset token is returned by the API or written to logs.
# 587 + false = STARTTLS (required in production); 465 + true = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# PC callback signing secret; separate from the PC API Key. Empty disables the receiver.
# Set the same 32..512-byte secret on both sides. Never commit the actual value.
PINGCODE_WEBHOOK_SECRET=
# Optional initial recharge rules JSON; saved administrator settings take precedence.
# Fields: currency (ISO 4217), fractionDigits (0..6), minimumMinor, maximumMinor, presetsMinor,
# exchangeAmountMinor, exchangePoints (e.g. configured amount -> configured whole points).
# Monetary amounts use integer minor units. Rules enable previews only; payments remain disconnected.
RECHARGE_RULES=
# Local-only login alias: admin (maps to DEMO_EMAIL).
DEMO_EMAIL=demo@linepool.local
DEMO_PASSWORD=12345678
