{
  "name": "@linepool/react-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test:pingcode": "npm run test:build && node --test --test-concurrency=1 dist-test/backend/test/pingcode-adapter.test.js dist-test/backend/test/pingcode-flow.test.js",
    "test": "npm run test:build && node --test --test-concurrency=1 dist-test/backend/test/*.test.js",
    "db:test:setup": "node dist/backend/scripts/test-database.js --initialize",
    "start": "node --env-file=.env dist/backend/src/main.js",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file=.env dist/backend/src/main.js\"",
    "db:local:setup": "node --env-file=.env dist/backend/scripts/local-postgres.js setup",
    "db:start": "node --env-file=.env dist/backend/scripts/local-postgres.js start",
    "db:stop": "node --env-file=.env dist/backend/scripts/local-postgres.js stop",
    "db:status": "node --env-file=.env dist/backend/scripts/local-postgres.js status",
    "db:create": "node --env-file=.env dist/backend/scripts/create-database.js",
    "db:migrate": "node --env-file=.env dist/backend/scripts/migrate.js",
    "db:seed": "node --env-file=.env dist/backend/scripts/seed.js",
    "db:seed:agent-inventory": "node --env-file=.env dist/backend/scripts/seed-agent-inventory.js",
    "db:allocation-audit": "node --env-file=.env dist/backend/scripts/allocation-audit.js",
    "mock:fulfillment": "node --env-file=.env dist/backend/scripts/mock-fulfillment.js",
    "admin:grant": "node --env-file=.env dist/backend/scripts/admin-grant.js"
  },
  "dependencies": {
    "@linepool/contracts": "0.1.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~5.9.3"
  }
}
